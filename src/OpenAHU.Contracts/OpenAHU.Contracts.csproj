<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OpenAHU.Contracts</RootNamespace>
    <AssemblyName>OpenAHU.Contracts</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    契约项目约定（3号维护，改动需跨组评审）：
    1. 本类库只放 DTO、错误结构与序列化约定，禁止引用 EF Core / Microsoft.Data.Sqlite /
       ASP.NET Core / WPF，也不放业务校验逻辑（校验属 04 Application）。
    2. DTO 的字段名、顺序、可空性、类型均为冻结契约；顺序即 JSON 字段顺序，不要随意重排。
    3. 未开启 TreatWarningsAsErrors：本环境无 .NET SDK 未做编译验证，
       严格化留给 06 号在 CI 中统一开启（见 README「验证状态」）。
  -->

</Project>
